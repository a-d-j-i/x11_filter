# The build products and the IDE's workspace are not part of the source.
# Under 3.0 (quilt) that matters because dpkg-source diffs the tree against the
# orig tarball and calls anything unexpected a local change; package.sh builds
# from a clean copy, so this is for anyone running dpkg-source by hand.
extend-diff-ignore = "^(\.idea/|\.github/|build/|__pycache__/|e2e\.local$|.*\.py[cod]$)"
